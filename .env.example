NEXT_PUBLIC_SITE_URL=http://localhost:5173
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only used by the admin AI content engine (question enrichment).
# Students never need this; the platform works fully without it.
OPENAI_API_KEY=
OPENAI_ADMIN_MODEL=gpt-4o-mini
# WhatsApp phone verification (Meta WhatsApp Business Cloud API)
# Default "inbound" (free): students send "VERIFY DC-XXXXXXXX" to your number.
PHONE_VERIFY_METHOD=inbound
# Your WhatsApp Business number, digits only, e.g. 919876543210
WHATSAPP_BUSINESS_NUMBER=
# Meta app > Settings > Basic > App secret (used to check webhook signatures)
WHATSAPP_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook setup
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Needed to send the free "You're verified" reply (and for the OTP fallback):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SEND_CONFIRMATION=1
WHATSAPP_GRAPH_VERSION=v25.0
# Fallback only (PHONE_VERIFY_METHOD=otp, billed by Meta): approved authentication template
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=en
# Local testing only: lets you simulate the WhatsApp message on the verify screen.
WHATSAPP_DEV_MODE=0

# Meta ads measurement (optional but recommended when running Meta ads)
# Pixel / dataset ID from Events Manager
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager > Settings > Conversions API > Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager > Test events code, while testing
META_CAPI_TEST_EVENT_CODE=

SECURITY_EMAIL_WEBHOOK_URL=
STRICT_ENV=0

# Local E2E account (any signed-up test student)
LOCAL_TEST_EMAIL=
LOCAL_TEST_PASSWORD=
